# Netlify reads this from the publish root, the same way it reads _redirects.
#
# Vite fingerprints everything under /assets/, so a given URL's bytes can never
# change. Without this they were served max-age=0,must-revalidate, which cost a
# conditional request per file on every repeat visit — eight round-trips to
# render a page whose content the browser already had.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand art keeps a stable filename, so it cannot be immutable. A week of
# freshness with a day of background revalidation keeps it off the critical
# path without stranding a logo change.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# index.html is the only file that names the current asset hashes, so it has to
# be revalidated every time or a deploy would never be picked up.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
