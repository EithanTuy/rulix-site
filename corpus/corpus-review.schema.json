{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulix.cloud/schemas/corpus-review.v1.json",
  "title": "Rulix qualified corpus review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "snapshotId",
    "reviewedAt",
    "reviewer",
    "sourceManifestHash",
    "candidateChecksum",
    "changedSourceIds",
    "affectedRuleIds",
    "parserRegression",
    "executableRuleValidationRecordIds",
    "attestation"
  ],
  "properties": {
    "schemaVersion": { "const": "rulix.corpus-review/v1" },
    "id": { "type": "string", "minLength": 2 },
    "snapshotId": { "type": "string", "minLength": 2 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "qualification"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "organization": { "type": "string", "minLength": 2 },
        "qualification": { "type": "string", "minLength": 2 }
      }
    },
    "sourceManifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changedSourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "affectedRuleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "parserRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "passed", "outputHash"],
      "properties": {
        "command": { "type": "string", "minLength": 2 },
        "passed": { "const": true },
        "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "executableRuleValidationRecordIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "attestation": {
      "const": "I compared the identified source text and parser output, recorded every material discrepancy, and accept responsibility for this corpus review."
    }
  }
}
